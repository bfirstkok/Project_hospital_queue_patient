+            "triage": datetime(2026, 10, 1, 11, 10, tzinfo=datetime_timezone.utc),
+            "queue": datetime(2026, 10, 1, 11, 30, tzinfo=datetime_timezone.utc),
+            "doctor": datetime(2026, 10, 1, 12, 0, tzinfo=datetime_timezone.utc),
+            "pharmacy": datetime(2026, 10, 1, 12, 30, tzinfo=datetime_timezone.utc),
+            "billing": datetime(2026, 10, 1, 12, 45, tzinfo=datetime_timezone.utc),
+            "complete": datetime(2026, 10, 1, 13, 0, tzinfo=datetime_timezone.utc),
+        }
+        self.visit.registered_at = stamps["registration"]
+        self.visit.triaged_at = stamps["vitals"]
+        self.visit.confirmed_at = stamps["triage"]
+        self.visit.called_at = stamps["queue"]
+        self.visit.save(update_fields=["registered_at", "triaged_at", "confirmed_at", "called_at"])
+
+        assessment = VisitAssessment.objects.create(
+            visit=self.visit,
+            examiner=get_user_model().objects.create_user(username="timestamp-doctor"),
+            diagnosis="ทดสอบ",
+        )
+        VisitAssessment.objects.filter(pk=assessment.pk).update(created_at=stamps["doctor"])
+
+        prescription = Prescription.objects.create(
+            visit=self.visit,
+            prescribed_by=assessment.examiner,
+            status=Prescription.Status.DISPENSED,
+        )
+        Prescription.objects.filter(pk=prescription.pk).update(
+            sent_at=stamps["pharmacy"],
+            dispensed_at=stamps["pharmacy"],
+        )
+        bill = Bill.objects.create(visit=self.visit, status=Bill.Status.PAID)
+        Bill.objects.filter(pk=bill.pk).update(
+            billing_queue_entered_at=stamps["billing"],
+            paid_at=stamps["billing"],
