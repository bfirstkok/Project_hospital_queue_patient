    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.6.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "jsdom": "26.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
